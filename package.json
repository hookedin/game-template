{
  "name": "@hookedin/game-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:hookedin/game-template",
  "engines": {
    "node": ">=24.4"
  },
  "scripts": {
    "build": "hookedin-game build",
    "dev": "hookedin-game serve",
